{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "document_reviews",
    "claim_reviews",
    "revision_instructions",
    "remaining_limitations"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "document_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "relevance",
          "reason",
          "quote"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^S-[0-9a-f]{12}$"
          },
          "relevance": {
            "type": "string",
            "enum": [
              "relevant",
              "historical",
              "different_entity",
              "unreliable",
              "unclear"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "claim_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "verdict",
          "issues",
          "rationale",
          "evidence",
          "correction"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^C[1-9][0-9]*$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "unsupported",
              "misleading",
              "conflicting"
            ]
          },
          "issues": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "entity",
                "date",
                "attribution",
                "numeric",
                "conflict",
                "unsupported",
                "source_injection",
                "clarity",
                "none"
              ]
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "quote",
                "published"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^S-[0-9a-f]{12}$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 8
                },
                "published": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              }
            }
          },
          "correction": {
            "type": "string"
          }
        }
      }
    },
    "revision_instructions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remaining_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
