{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_name",
    "brief_markdown",
    "claims"
  ],
  "properties": {
    "entity_name": {
      "type": "string",
      "minLength": 1
    },
    "brief_markdown": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "kind",
          "entity",
          "period",
          "evidence"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^C[1-9][0-9]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "management_view",
              "inference",
              "question"
            ]
          },
          "entity": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "quote",
                "published"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^S-[0-9a-f]{12}$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 8
                },
                "published": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
